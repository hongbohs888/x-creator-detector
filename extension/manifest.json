{
  "manifest_version": 3,
  "name": "X 博主探测",
  "version": "1.4.0",
  "description": "在 X 页面直接显示粉丝数、账号标签和转发榜。只读取页面已经加载的数据，不发任何额外请求。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "X 博主探测",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["defaults.js", "rules.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
